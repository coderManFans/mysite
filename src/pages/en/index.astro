---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="CODERMAN"
  description="Software Developer focused on AI-assisted development, engineering tools, and technical writing."
  lang="en"
  alternateUrl="/"
>
  <section class="hero">
    <p class="eyebrow">Software Developer</p>
    <h1>CODERMAN</h1>
    <p class="lead">AI-assisted software development, engineering tools, and practical technical writing.</p>
    <div class="actions">
      <a class="button primary" href="/en/blog/">Read Blog</a>
      <a class="button" href="#contact">Contact Me</a>
    </div>
  </section>

  <section class="section-grid" aria-labelledby="focus-title">
    <div>
      <p class="eyebrow">Focus</p>
      <h2 id="focus-title">Technical Focus</h2>
    </div>
    <div class="text-block">
      <p>I write about software engineering, AI-assisted development, tooling, and personal knowledge management through project notes and practical engineering records.</p>
    </div>
  </section>

  <section class="section-grid" id="contact" aria-labelledby="contact-title">
    <div>
      <p class="eyebrow">Contact</p>
      <h2 id="contact-title">Get in Touch</h2>
    </div>
    <div class="contact-panel">
      <div class="contact-links" aria-label="Contact links">
        <a href="mailto:2217011466@qq.com">
          <span>Email</span>
          <strong>2217011466@qq.com</strong>
        </a>
        <a href="https://github.com/coderManFans" target="_blank" rel="noreferrer">
          <span>GitHub</span>
          <strong>github.com/coderManFans</strong>
        </a>
        <a href="https://gitee.com/codergit.com" target="_blank" rel="noreferrer">
          <span>Gitee</span>
          <strong>gitee.com/codergit.com</strong>
        </a>
      </div>
      <figure class="wechat-card">
        <img src="/images/wechat-official-account.jpg" alt="QR code for the WeChat official account" width="220" height="220" loading="lazy" />
        <figcaption>
          <span>WeChat Official Account</span>
          <strong>神帅的技术圈</strong>
        </figcaption>
      </figure>
    </div>
  </section>
</BaseLayout>
