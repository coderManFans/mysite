---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import {
  blogCategories,
  getBlogCategoryLabel
} from '../../../../lib/blogCategories';
import { getBlogPostPath } from '../../../../lib/blogI18n';

export function getStaticPaths() {
  return blogCategories.map((category) => ({
    params: { category: category.slug },
    props: { category }
  }));
}

const { category } = Astro.props;
const lang = 'en';
const posts = (await getCollection('blog', ({ data }) =>
  !data.draft && data.lang === lang && data.category === category.slug
)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' }).format(date);

const allPosts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === lang));
const categoryCounts = new Map<string, number>();
for (const post of allPosts) {
  categoryCounts.set(post.data.category, (categoryCounts.get(post.data.category) ?? 0) + 1);
}
---
<BaseLayout title={`${category.label} | Blog`} description={category.description} lang="en" alternateUrl={`/blog/category/${category.slug}/`}>
  <section class="page-heading">
    <p class="eyebrow">Blog / Category</p>
    <h1>{category.label}</h1>
    <p>{category.description}</p>
  </section>

  <section class="category-filter" aria-label="Blog category filter">
    <a class="category-chip" href="/en/blog/">All <span>{allPosts.length}</span></a>
    {blogCategories.map((item) => (
      <a
        class:list={["category-chip", { active: item.slug === category.slug }]}
        href={`/en/blog/category/${item.slug}/`}
        title={item.description}
      >
        {item.label}
        <span>{categoryCounts.get(item.slug) ?? 0}</span>
      </a>
    ))}
  </section>

  {posts.length === 0 && (
    <p class="empty-state">No English posts in this category yet.</p>
  )}

  <section class="post-list" aria-label={`${category.label} post list`}>
    {posts.map((post) => (
      <article class="post-card">
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <span>{getBlogCategoryLabel(post.data.category)}</span>
          {post.data.tags.length > 0 && <span>{post.data.tags.join(' / ')}</span>}
        </div>
        <h2><a href={getBlogPostPath(post.id, post.data.lang)}>{post.data.title}</a></h2>
        {post.data.description && <p>{post.data.description}</p>}
      </article>
    ))}
  </section>
</BaseLayout>
