---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { blogCategories, getBlogCategoryLabel } from '../../../lib/blogCategories';
import { getBlogPostPath } from '../../../lib/blogI18n';

const lang = 'en';
const activeCategory = 'all';

const allPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft && post.data.lang === lang)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categoryCounts = new Map<string, number>();
for (const post of allPosts) {
  categoryCounts.set(post.data.category, (categoryCounts.get(post.data.category) ?? 0) + 1);
}

const posts = activeCategory === 'all'
  ? allPosts
  : allPosts.filter((post) => post.data.category === activeCategory);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' }).format(date);
---
<BaseLayout title="Blog" description="CODERMAN's technical blog and development notes." lang="en" alternateUrl="/blog/">
  <section class="page-heading">
    <p class="eyebrow">Blog</p>
    <h1>Technical Blog</h1>
    <p>Notes on software development, AI tooling, and personal project practices.</p>
  </section>

  <section class="category-filter" aria-label="Blog category filter">
    <a class:list={["category-chip", { active: activeCategory === 'all' }]} href="/en/blog/">
      All
      <span>{allPosts.length}</span>
    </a>
    {blogCategories.map((category) => (
      <a
        class:list={["category-chip", { active: activeCategory === category.slug }]}
        href={`/en/blog/category/${category.slug}/`}
        title={category.description}
      >
        {category.label}
        <span>{categoryCounts.get(category.slug) ?? 0}</span>
      </a>
    ))}
  </section>

  {posts.length === 0 && (
    <p class="empty-state">No English posts yet. Translated articles will appear here later.</p>
  )}

  <section class="post-list" aria-label="Blog post list">
    {posts.map((post) => (
      <article class="post-card">
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <span>{getBlogCategoryLabel(post.data.category)}</span>
          {post.data.tags.length > 0 && <span>{post.data.tags.join(' / ')}</span>}
        </div>
        <h2><a href={getBlogPostPath(post.id, post.data.lang)}>{post.data.title}</a></h2>
        {post.data.description && <p>{post.data.description}</p>}
      </article>
    ))}
  </section>
</BaseLayout>
