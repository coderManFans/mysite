---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Giscus from '../../components/Giscus.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import SeriesNavigation from '../../components/SeriesNavigation.astro';
import { getRelatedPosts } from '../../lib/relatedPosts';
import { getSeriesNavigation } from '../../lib/seriesNavigation';
import { getBlogPostPath, getBlogPostSlug } from '../../lib/blogI18n';
import { getBlogCategoryLabel } from '../../lib/blogCategories';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft && data.lang === 'zh');

  return posts.map((post) => ({
    params: {
      slug: getBlogPostSlug(post.id)
    },
    props: { post }
  }));
}

const { post } = Astro.props;
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const alternatePost = allPosts.find((item) =>
  item.data.lang === 'en' &&
  (item.data.translationKey ?? getBlogPostSlug(item.id)) === (post.data.translationKey ?? getBlogPostSlug(post.id))
);
const alternateUrl = alternatePost ? getBlogPostPath(alternatePost.id, alternatePost.data.lang) : '/en/blog/';
const { Content, headings } = await render(post);
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('zh-CN', { dateStyle: 'medium' }).format(date);
const ogImage = `/images/og/zh-${getBlogPostSlug(post.id)}.png`;
const publishedTime = post.data.pubDate instanceof Date ? post.data.pubDate.toISOString() : undefined;
const updatedTime =
  post.data.updatedDate instanceof Date ? post.data.updatedDate.toISOString() : undefined;
const relatedPosts = getRelatedPosts(post, allPosts);
const seriesNavigation = getSeriesNavigation(post, allPosts);
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  alternateUrl={alternateUrl}
  ogType="article"
  ogImage={ogImage}
  publishedTime={publishedTime}
  updatedTime={updatedTime}
>
  <ReadingProgress lang="zh" />
  <article class="article">
    <header class="article-header">
      <a class="back-link" href="/blog/">← 返回博客</a>
      <p class="eyebrow">{formatDate(post.data.pubDate)}</p>
      <h1>{post.data.title}</h1>
      {post.data.description && <p>{post.data.description}</p>}
      <div class="tag-list" aria-label="文章分类和标签">
        <span class="category-label">{getBlogCategoryLabel(post.data.category)}</span>
        {post.data.tags.map((tag) => <span>{tag}</span>)}
      </div>
    </header>
    <TableOfContents headings={headings} lang="zh" />
    <div class="prose">
      <Content />
    </div>
    <RelatedPosts posts={relatedPosts} lang="zh" />
    <SeriesNavigation navigation={seriesNavigation} categoryLabel={getBlogCategoryLabel(post.data.category)} lang="zh" />
  </article>
  <div class="article-comments">
    <Giscus lang="zh" />
  </div>
</BaseLayout>
