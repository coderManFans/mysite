---
interface Props {
  lang?: 'zh' | 'en';
}

const { lang = 'zh' } = Astro.props;
const isEnglish = lang === 'en';
const repo = 'coderManFans/coderman-comments';
const repoId = 'R_kgDOVcgtqg';
const category = 'General';
const categoryId = 'DIC_kwDOVcgtqs4DJ9wn';
---
<section class="comments" aria-label={isEnglish ? 'Comments' : '评论'}>
  <h2>{isEnglish ? 'Comments' : '评论'}</h2>
  <p class="comments-hint">
    {
      isEnglish
        ? 'Comments are powered by GitHub Discussions. Sign in with GitHub to join the discussion.'
        : '评论由 GitHub Discussions 提供，使用 GitHub 账号登录后即可参与讨论。'
    }
  </p>
  <script
    src="https://giscus.app/client.js"
    data-repo={repo}
    data-repo-id={repoId}
    data-category={category}
    data-category-id={categoryId}
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="preferred_color_scheme"
    data-lang={isEnglish ? 'en' : 'zh-CN'}
    crossorigin="anonymous"
    async
  ></script>
</section>
