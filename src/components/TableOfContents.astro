---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  lang?: 'zh' | 'en';
}

const { headings, lang = 'zh' } = Astro.props;
const isEnglish = lang === 'en';

const usable = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 4);
const baseDepth = usable.length > 0 ? Math.min(...usable.map((heading) => heading.depth)) : 0;
const tocItems = usable.map((heading) => ({
  slug: heading.slug,
  text: heading.text,
  level: Math.min(heading.depth - baseDepth + 1, 2)
}));
const topLevelCount = tocItems.filter((item) => item.level === 1).length;
const showToc = topLevelCount >= 2;
// Long collections collapse by default so the table of contents does not push the article down.
const collapsible = tocItems.length > 40;
const Wrapper = collapsible ? 'details' : 'nav';
const summaryLabel = isEnglish
  ? `On this page (${topLevelCount} parts, ${tocItems.length} entries)`
  : `目录（${topLevelCount} 个部分，共 ${tocItems.length} 条）`;
---
{
  showToc && (
    <Wrapper class:list={['toc', { 'toc-collapsible': collapsible }]} aria-labelledby="toc-title">
      {collapsible ? (
        <summary id="toc-title" class="toc-title">{summaryLabel}</summary>
      ) : (
        <h2 id="toc-title" class="toc-title">{isEnglish ? 'On this page' : '目录'}</h2>
      )}
      <ol class="toc-list">
        {tocItems.map((item) => (
          <li class:list={['toc-item', `toc-level-${item.level}`]}>
            <a href={`#${item.slug}`}>{item.text}</a>
          </li>
        ))}
      </ol>
    </Wrapper>
  )
}
