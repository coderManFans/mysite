---
import type { SeriesNavigation } from '../lib/seriesNavigation';
import { getBlogPostPath } from '../lib/blogI18n';

interface Props {
  navigation: SeriesNavigation;
  categoryLabel: string;
  lang?: 'zh' | 'en';
}

const { navigation, categoryLabel, lang = 'zh' } = Astro.props;
const isEnglish = lang === 'en';
const { previous, next } = navigation;
const visible = Boolean(previous || next);
---
{
  visible && (
    <nav class="series-nav" aria-labelledby="series-title">
      <h2 id="series-title" class="series-title">
        {isEnglish ? 'More in this series' : `「${categoryLabel}」系列`}
      </h2>
      <div class="series-links">
        {previous ? (
          <a class="series-link series-prev" href={getBlogPostPath(previous.id, previous.data.lang)}>
            <span class="series-dir">{isEnglish ? 'Previous' : '上一篇'}</span>
            <strong>{previous.data.title}</strong>
          </a>
        ) : (
          <span class="series-placeholder" aria-hidden="true" />
        )}
        {next ? (
          <a class="series-link series-next" href={getBlogPostPath(next.id, next.data.lang)}>
            <span class="series-dir">{isEnglish ? 'Next' : '下一篇'}</span>
            <strong>{next.data.title}</strong>
          </a>
        ) : (
          <span class="series-placeholder" aria-hidden="true" />
        )}
      </div>
    </nav>
  )
}
