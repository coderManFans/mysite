---
interface Props {
  title: string;
  description?: string;
  lang?: 'zh' | 'en';
  alternateUrl?: string;
}

import { getBlogIndexPath, getHomePath, getHtmlLang } from '../lib/blogI18n';

const {
  title,
  description = 'CODERMAN personal website and technical blog.',
  lang = 'zh',
  alternateUrl
} = Astro.props;
const pageTitle = title === 'CODERMAN' ? title : `${title} | CODERMAN`;
const isEnglish = lang === 'en';
const homePath = getHomePath(lang);
const blogPath = getBlogIndexPath(lang);
const contactPath = `${homePath}#contact`;
const defaultAlternateUrl = isEnglish ? Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/' : `/en${Astro.url.pathname === '/' ? '' : Astro.url.pathname}`;
const languageSwitchUrl = alternateUrl ?? defaultAlternateUrl;
const languageSwitchLabel = isEnglish ? '中文' : 'English';
---
<!doctype html>
<html lang={getHtmlLang(lang)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={homePath}>CODERMAN</a>
      <nav aria-label={isEnglish ? 'Main navigation' : '主导航'}>
        <a href={blogPath}>Blog</a>
        <a href={contactPath}>{isEnglish ? 'Contact' : 'Contact'}</a>
        <a href={languageSwitchUrl}>{languageSwitchLabel}</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} CODERMAN</p>
    </footer>
  </body>
</html>
